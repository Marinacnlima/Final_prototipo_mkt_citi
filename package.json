{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:db": "tsx server/src/local-db.ts",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "build": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "gmail:token": "tsx server/scripts/get-gmail-refresh-token.ts",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.28.0",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "oxfmt": "^0.2.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
