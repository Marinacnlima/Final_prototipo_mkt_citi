DATABASE_URL="postgresql://marketops:marketops@127.0.0.1:5432/marketops"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"
JWT_EXPIRES_IN="8h"
PORT=3001
CORS_ORIGIN="http://localhost:5174"

# E-mail (Gmail API / OAuth2) — usado no fluxo de "esqueceu a senha"
# Sem essas credenciais, o código de verificação é apenas logado no console do servidor (modo dev)
# Gere GMAIL_REFRESH_TOKEN rodando: pnpm tsx server/scripts/get-gmail-refresh-token.ts
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER="noreply.marketops@gmail.com"
EMAIL_FROM_NAME="CITi MarketOps"
RESET_CODE_TTL_MINUTES=15

# Upload de arquivos (materiais ricos e mídia de posts)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=20
