DATABASE_URL="postgresql://marketops:marketops@127.0.0.1:5432/marketops"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"
JWT_EXPIRES_IN="8h"
PORT=3001
CORS_ORIGIN="http://localhost:5174"

# E-mail (SendGrid) — usado no fluxo de "esqueceu a senha"
# Sem SENDGRID_API_KEY, o código de verificação é apenas logado no console do servidor (modo dev)
SENDGRID_API_KEY=""
EMAIL_FROM="no-reply@marketops.local"
EMAIL_FROM_NAME="CITi MarketOps"
RESET_CODE_TTL_MINUTES=15

# Upload de arquivos (materiais ricos e mídia de posts)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=20
